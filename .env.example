# Partner Hub Supabase project (public/shared/partner-hub-setup.sql).
# Copy this file to .env and fill in your project's values from
# Project Settings -> API in the Supabase dashboard.
# The anon key is safe to expose in the client bundle -- Row Level Security
# policies are the real security boundary, not secrecy of this key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
